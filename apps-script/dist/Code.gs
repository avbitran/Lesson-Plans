// Online Tests — the whole app: paste this into Code.gs. Generated by build.js from apps-script/src/; edit those files, not this one.

// ===== Core.js =====
// Test definitions: validation, the student-safe view, and auto-grading.

const QUESTION_TYPES = ['section', 'mc', 'short', 'long', 'blanks', 'match'];
const VOICE_PROVIDERS = ['browser', 'google', 'chatterbox'];
const MAX_BLANKS = 80;

// Fill in the blanks: each answer sits in {curly braces} inside the text,
// alternatives split by | ("{to play|playing}"). Empty braces {} are a blank
// the teacher marks.
const BLANK_RE = /\{([^{}]*)\}/g;
function parseBlanks(prompt) {
  const out = [];
  String(prompt || '').replace(BLANK_RE, (_, inner) => {
    out.push(inner.split('|').map((x) => x.trim()).filter(Boolean));
    return '';
  });
  return out;
}

// The order students see matching choices in: shuffled, but the same every
// time for a given question, so read-aloud audio and saved answers line up.
function seededShuffle(list, seed) {
  let h = 2166136261;
  for (const ch of String(seed)) h = Math.imul(h ^ ch.charCodeAt(0), 16777619) >>> 0;
  const out = list.slice();
  for (let i = out.length - 1; i > 0; i--) {
    h = Math.imul(h ^ (h >>> 15), 2246822507) >>> 0;
    h = Math.imul(h ^ (h >>> 13), 3266489909) >>> 0;
    const j = ((h ^ (h >>> 16)) >>> 0) % (i + 1);
    [out[i], out[j]] = [out[j], out[i]];
  }
  return out;
}

function matchChoices(q) {
  return [...new Set(q.pairs.map((p) => p.right).concat(q.extra || []))];
}
const LANGUAGES = ['en-US', 'en-GB', 'he-IL', 'ar-SA', 'ru-RU', 'fr-FR', 'es-ES', 'de-DE'];
const ON_LIMIT = ['log', 'lock', 'submit'];
const SHOW_RESULTS = ['none', 'score', 'full'];

class ValidationError extends Error {}

const str = (v, max) => String(v ?? '').slice(0, max);
const int = (v, min, max, dflt) => {
  const n = Number.parseInt(v, 10);
  return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : dflt;
};
const num = (v, min, max, dflt) => {
  const n = Number(v);
  return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : dflt;
};

function normalizeTest(input) {
  if (!input || typeof input !== 'object') throw new ValidationError('Test data is missing.');
  const title = str(input.title, 200).trim();
  if (!title) throw new ValidationError('The test needs a title.');
  if (!Array.isArray(input.questions)) throw new ValidationError('The test has no questions list.');
  if (input.questions.length > 300) throw new ValidationError('A test can have at most 300 items.');

  const s = input.settings || {};
  const seen = new Set();
  const questions = input.questions.map((q, i) => {
    const type = QUESTION_TYPES.includes(q?.type) ? q.type : null;
    if (!type) throw new ValidationError(`Item ${i + 1} has an unknown type.`);
    let id = str(q.id, 40).replace(/[^A-Za-z0-9_-]/g, '');
    if (!id || seen.has(id)) id = `q${i + 1}_${Math.random().toString(36).slice(2, 7)}`;
    seen.add(id);
    const out = { id, type, title: str(q.title, 300), prompt: str(q.prompt, 20000) };
    if (type === 'section') return out;
    out.points = num(q.points, 0, 1000, 1);
    if (type === 'mc') {
      const options = (Array.isArray(q.options) ? q.options : []).map((o) => str(o, 1000)).filter((o) => o.trim());
      if (options.length < 2) throw new ValidationError(`Question ${i + 1} needs at least two options.`);
      out.options = options.slice(0, 12);
      if (q.multiple) {
        // "Choose the TWO correct answers": several options are right.
        const picks = (Array.isArray(q.correct) ? q.correct : [q.correct])
          .map((c) => parseInt(c, 10))
          .filter((c) => Number.isInteger(c) && c >= 0 && c < out.options.length);
        out.multiple = true;
        out.correct = [...new Set(picks)].sort((a, b) => a - b);
        if (!out.correct.length) throw new ValidationError(`Question ${i + 1}: mark at least one correct answer.`);
        out.scoring = q.scoring === 'all' ? 'all' : 'partial';
      } else {
        out.correct = int(Array.isArray(q.correct) ? q.correct[0] : q.correct, 0, out.options.length - 1, 0);
      }
    }
    if (type === 'short') {
      out.accepted = (Array.isArray(q.accepted) ? q.accepted : [])
        .map((a) => str(a, 500).trim())
        .filter(Boolean)
        .slice(0, 30);
    }
    if (type === 'long') out.modelAnswer = str(q.modelAnswer, 5000);
    if (type === 'blanks') {
      const n = parseBlanks(out.prompt).length;
      if (!n) throw new ValidationError(`Question ${i + 1}: put each answer in {curly braces}, e.g. "She opened a small {business}."`);
      if (n > MAX_BLANKS) throw new ValidationError(`Question ${i + 1} has more than ${MAX_BLANKS} blanks. Split it into two questions.`);
      out.wordBank = (Array.isArray(q.wordBank) ? q.wordBank : [])
        .map((w) => str(w, 200).trim())
        .filter(Boolean)
        .slice(0, 60);
      out.dropdown = !!q.dropdown && out.wordBank.length > 0;
    }
    if (type === 'match') {
      out.pairs = (Array.isArray(q.pairs) ? q.pairs : [])
        .map((p) => ({ left: str(p && p.left, 500).trim(), right: str(p && p.right, 500).trim() }))
        .filter((p) => p.left && p.right)
        .slice(0, 40);
      if (out.pairs.length < 2) throw new ValidationError(`Question ${i + 1} needs at least two pairs to match.`);
      out.extra = (Array.isArray(q.extra) ? q.extra : [])
        .map((x) => str(x, 500).trim())
        .filter(Boolean)
        .slice(0, 10);
    }
    if (!out.prompt.trim() && !out.title.trim() && type !== 'match') throw new ValidationError(`Question ${i + 1} has no text.`);
    return out;
  });

  return {
    title,
    instructions: str(input.instructions, 5000),
    language: LANGUAGES.includes(input.language) ? input.language : 'en-US',
    timeLimitMin: int(input.timeLimitMin, 0, 600, 0),
    classes: (Array.isArray(input.classes) ? input.classes : [])
      .map((c) => str(c, 60).trim())
      .filter(Boolean)
      .slice(0, 50),
    settings: {
      requireFullscreen: s.requireFullscreen !== false,
      maxViolations: int(s.maxViolations, 0, 50, 3),
      onLimit: ON_LIMIT.includes(s.onLimit) ? s.onLimit : 'lock',
      blockCopyPaste: s.blockCopyPaste !== false,
      readAloudForAll: !!s.readAloudForAll,
      recordingForAll: !!s.recordingForAll,
      showResults: SHOW_RESULTS.includes(s.showResults) ? s.showResults : 'score',
      voice: {
        provider: VOICE_PROVIDERS.includes(s.voice && s.voice.provider) ? s.voice.provider : 'browser',
        name: str(s.voice && s.voice.name, 100).trim(),
      },
    },
    questions,
  };
}

// What a student's browser gets: no correct answers, no model answers.
// Every item also carries `speech`, the exact text read aloud, and `audio`,
// the id of prepared natural-voice audio for it (null: use the device voice).
// audioFor(text) looks that id up; it's optional.
function studentView(test, audioFor) {
  const find = audioFor || (() => null);
  const questions = test.questions.map(({ correct, accepted, modelAnswer, scoring, pairs, extra, ...rest }) => {
    const q = { ...rest };
    if (rest.multiple) q.choose = correct.length;
    if (rest.type === 'blanks') {
      q.prompt = rest.prompt.replace(BLANK_RE, '{}');
      q.blankCount = parseBlanks(rest.prompt).length;
    }
    if (rest.type === 'match') {
      q.left = pairs.map((p) => p.left);
      q.right = seededShuffle(matchChoices({ pairs, extra }), rest.id);
    }
    q.speech = speechText(q);
    q.audio = find(q.speech);
    return q;
  });
  const instructionsSpeech = sentence(test.instructions);
  return { ...test, questions, instructionsSpeech, instructionsAudio: instructionsSpeech ? find(instructionsSpeech) : null };
}

// Ends a piece of text with punctuation so voices pause naturally.
function sentence(s) {
  const t = String(s || '').trim();
  return !t || /[.!?:;…"'”)\]]$/.test(t) ? t : `${t}.`;
}

const LETTERS_ = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';

// "a small ___ selling" is read as "a small … blank … selling".
const blankWords = (s) =>
  String(s || '')
    .replace(/\s*_{2,}\s*/g, ' … blank … ')
    .replace(/[ \t]+/g, ' ')
    .replace(/ ([.,!?;:])/g, '$1')
    .trim();

// What 🔊 Listen reads for one item (given the student version of it).
function speechText(q) {
  const parts = [sentence(q.title)];
  if (q.type === 'blanks') {
    if (q.wordBank && q.wordBank.length) parts.push(sentence(`The words are: ${q.wordBank.join(', ')}`));
    for (const line of q.prompt.split('\n')) parts.push(sentence(blankWords(line.replace(/\{\}/g, '___'))));
  } else if (q.type === 'match') {
    parts.push(sentence(q.prompt));
    q.left.forEach((l, i) => parts.push(sentence(`${i + 1}: ${l}`)));
    parts.push('The choices are:');
    q.right.forEach((r, i) => parts.push(sentence(`${LETTERS_[i]}: ${r}`)));
  } else {
    parts.push(sentence(blankWords(q.prompt)));
    if (q.multiple) parts.push(`Choose ${q.choose} answers.`);
    if (q.type === 'mc') q.options.forEach((o, i) => parts.push(sentence(`${LETTERS_[i]}: ${o}`)));
  }
  return parts.filter(Boolean).join('\n');
}

// Splits text for a speech service: by language (Hebrew and Arabic stretches
// get their own voice) and into pieces of at most maxLen characters, cut at
// sentence ends where possible.
function ttsPieces(text, lang, maxLen) {
  const scriptOf = (s) => (/[֐-׿]/.test(s) ? 'he-IL' : /[؀-ۿ]/.test(s) ? 'ar-SA' : null);
  const sentences = String(text || '')
    .split(/(?<=[.!?;:…])\s+|\n+/)
    .map((x) => x.trim())
    .filter(Boolean);
  const pieces = [];
  for (let sen of sentences) {
    const l = scriptOf(sen) || lang;
    while (sen.length > maxLen) {
      const cut = sen.lastIndexOf(' ', maxLen) > maxLen / 2 ? sen.lastIndexOf(' ', maxLen) : maxLen;
      pieces.push({ text: sen.slice(0, cut).trim(), lang: l });
      sen = sen.slice(cut).trim();
    }
    const last = pieces[pieces.length - 1];
    if (last && last.lang === l && last.text.length + sen.length + 1 <= maxLen) last.text += ` ${sen}`;
    else if (sen) pieces.push({ text: sen, lang: l });
  }
  return pieces;
}

function maxScore(test) {
  return test.questions.reduce((sum, q) => sum + (q.type === 'section' ? 0 : q.points), 0);
}

// Typing differences that shouldn't cost a point: case, spacing, curly
// apostrophes, a trailing full stop.
function normalizeAnswer(s) {
  return String(s ?? '')
    .normalize('NFKC')
    .toLowerCase()
    .replace(/[‘’ʼ`´]/g, "'")
    .replace(/[“”]/g, '"')
    .replace(/\s+/g, ' ')
    .trim()
    .replace(/[.!]+$/, '')
    .trim();
}

/**
 * Per-question automatic marks.
 * auto: points awarded automatically, or null when only the teacher can mark it.
 * review: true when the teacher should look (manual items, voice answers,
 *         short answers that matched nothing in the accepted list).
 */
function autoGrade(test, answers, recordedQuestionIds) {
  const result = {};
  for (const q of test.questions) {
    if (q.type === 'section') continue;
    const a = answers[q.id];
    const recorded = recordedQuestionIds.has(q.id);
    const empty =
      a === undefined || a === null || (typeof a === 'string' && !a.trim()) || (Array.isArray(a) && !a.some((x) => (typeof x === 'string' ? x.trim() : x !== null && x !== undefined)));
    let auto = null;
    let review = true;
    const emptyList = Array.isArray(a) && !a.some((x) => (typeof x === 'string' ? x.trim() : x !== null && x !== undefined));
    if ((q.type === 'blanks' || q.type === 'match') && Array.isArray(a) && !emptyList) {
      const g = q.type === 'blanks' ? gradeBlanks(q, a) : gradeMatch(q, a);
      auto = g.auto;
      review = g.review || recorded;
    } else if (q.type === 'mc' && q.multiple && Array.isArray(a) && a.length) {
      auto = scoreMultiple(q, a);
      review = recorded;
    } else if (q.type === 'mc' && !q.multiple && Number.isInteger(a)) {
      auto = a === q.correct ? q.points : 0;
      review = recorded;
    } else if (q.type === 'short' && !empty) {
      const ok = q.accepted.some((acc) => normalizeAnswer(acc) === normalizeAnswer(a));
      auto = ok ? q.points : 0;
      review = !ok || recorded;
    } else if (empty && !recorded) {
      auto = 0;
      review = false;
    }
    result[q.id] = { auto, review, max: q.points };
  }
  return result;
}

const share = (points, hits, total) => Math.round((points * hits * 100) / total) / 100;

// Each blank is worth an equal share. A blank with no accepted answers, or an
// answer that matched none, is left for the teacher to check.
function gradeBlanks(q, a) {
  const keys = parseBlanks(q.prompt);
  let hits = 0;
  let review = false;
  keys.forEach((accepted, i) => {
    const given = typeof a[i] === 'string' ? a[i] : '';
    if (!accepted.length) {
      if (given.trim()) review = true;
      return;
    }
    if (accepted.some((acc) => normalizeAnswer(acc) === normalizeAnswer(given))) hits++;
    else if (given.trim()) review = true;
  });
  return { auto: share(q.points, hits, keys.length), review };
}

function gradeMatch(q, a) {
  const hits = q.pairs.filter((p, i) => typeof a[i] === 'string' && normalizeAnswer(a[i]) === normalizeAnswer(p.right)).length;
  return { auto: share(q.points, hits, q.pairs.length), review: false };
}

// Partial: an equal share of the points for each correct option chosen
// (choosing more options than allowed scores nothing). All: everything right
// or zero.
function scoreMultiple(q, picks) {
  const chosen = [...new Set(picks)];
  if (chosen.length > q.correct.length) return 0;
  const hits = chosen.filter((c) => q.correct.includes(c)).length;
  if (q.scoring === 'all') return hits === q.correct.length ? q.points : 0;
  return Math.round((q.points * hits * 100) / q.correct.length) / 100;
}

// Teacher marks win; otherwise the automatic mark; otherwise nothing yet.
function totalScore(test, auto, grading) {
  let total = 0;
  for (const q of test.questions) {
    if (q.type === 'section') continue;
    const g = grading[q.id];
    const pts = g && Number.isFinite(g.points) ? g.points : auto[q.id]?.auto;
    total += Number.isFinite(pts) ? pts : 0;
  }
  return Math.round(total * 100) / 100;
}

if (typeof module !== 'undefined') {
  module.exports = {
    ValidationError, normalizeTest, studentView, maxScore, normalizeAnswer, autoGrade, totalScore, LANGUAGES,
    parseBlanks, matchChoices, seededShuffle, speechText, ttsPieces, sentence, VOICE_PROVIDERS,
  };
}

// ===== Api.js =====
// Every request from the pages goes through handle(method, path, body, user).
// Storage, Drive and locking are passed in, so the same code runs in Apps
// Script (Sheets + Drive) and in the Node tests (in-memory fakes).

const DEADLINE_GRACE_MS = 30e3; // network slack for the last autosave
const MAX_EVENTS_PER_ATTEMPT = 1000;
const MAX_AUDIO_BASE64 = 14 * 1024 * 1024; // about 10 MB of audio
const AUDIO_BUDGET_MS = 40e3; // natural-voice audio made per request, then the page asks again
const COUNTED_EVENTS = ['left', 'fullscreen_exit'];
const LOGGED_EVENTS = ['returned', 'paste_blocked', 'copy_blocked', 'shortcut_blocked', 'fullscreen_refused', 'recorder_opened'];

class HttpError extends Error {
  constructor(status, message) {
    super(message);
    this.status = status;
  }
}

function createApi(env) {
  const { db, files, withLock, exportResults } = env;
  const clock = env.clock || (() => Date.now()); // real time, for work budgets
  const now = env.now || (() => Date.now());
  const routes = [];
  const route = (method, pattern, role, handler) => {
    const keys = [];
    const re = new RegExp('^' + pattern.replace(/:(\w+)/g, (_, k) => (keys.push(k), '([^/]+)')) + '$');
    routes.push({ method, re, keys, role, handler });
  };

  // ------------------------------------------------------------- helpers

  const ownerEmail = () => env.ownerEmail;

  function getTest(id) {
    const t = db.get('tests', String(id));
    if (!t) throw new HttpError(404, 'Test not found.');
    return t;
  }

  function getAttempt(id) {
    const a = db.get('attempts', String(id));
    if (!a) throw new HttpError(404, 'Attempt not found.');
    a.answers = a.answers || {};
    a.grading = a.grading || {};
    return a;
  }

  function ownAttempt(id, user) {
    const a = getAttempt(id);
    if (a.studentId !== user.id) throw new HttpError(404, 'Attempt not found.');
    return a;
  }

  const recordingsOf = (attemptId) => db.all('recordings').filter((r) => r.attemptId === attemptId);
  const recordedIds = (attemptId) => new Set(recordingsOf(attemptId).map((r) => r.questionId));

  function logEvent(attemptId, type, detail, counted) {
    db.insert('events', { attemptId, at: now(), type, detail: String(detail || '').slice(0, 300), counted: !!counted });
  }

  function submitAttempt(a, reason) {
    const auto = autoGrade(a.snapshot, a.answers, recordedIds(a.id));
    db.update('attempts', a.id, {
      status: 'submitted',
      submittedAt: now(),
      submitReason: reason,
      score: totalScore(a.snapshot, auto, a.grading),
      maxScore: maxScore(a.snapshot),
    });
    a.status = 'submitted';
    logEvent(a.id, 'submitted', reason, false);
  }

  // Attempts whose time ran out while the student was away get submitted
  // with whatever was autosaved.
  function sweepExpired(attempts) {
    for (const a of attempts || db.all('attempts', true)) {
      if ((a.status === 'in_progress' || a.status === 'locked') && a.deadlineAt && a.deadlineAt + DEADLINE_GRACE_MS < now()) {
        submitAttempt(getAttempt(a.id), 'time');
      }
    }
  }

  function removeRecordings(list) {
    for (const r of list) {
      files.remove(r.fileId);
      db.remove('recordings', r.id);
    }
  }

  function removeAttempt(a) {
    removeRecordings(recordingsOf(a.id));
    db.removeWhere('events', (e) => e.attemptId === a.id);
    db.remove('attempts', a.id);
  }

  // ------------------------------------------------- natural-voice audio
  // Audio is made once per piece of text and voice, stored in Drive, and
  // shared by every test that reads the same text with the same voice.

  const voiceOf = (test) => (test.settings && test.settings.voice) || { provider: 'browser', name: '' };
  const naturalVoice = (test) => voiceOf(test).provider !== 'browser' && !!env.tts;
  const clipId = (voice, lang, text) => env.hash(`${voice.provider}|${voice.name}|${lang}|${text}`).slice(0, 24);

  let audioIds = null;
  const audioReady = (id) => (audioIds ||= new Set(db.all('audio', true).map((x) => x.id))).has(id);

  // studentView's audio lookup for one test.
  const audioFor = (test) => {
    if (!naturalVoice(test)) return null;
    const v = voiceOf(test);
    return (text) => {
      const id = clipId(v, test.language, text);
      return audioReady(id) ? id : null;
    };
  };
  const viewOf = (test) => studentView(test, audioFor(test));

  // Every piece of text a test reads aloud.
  const speechList = (test) => {
    const view = studentView(test);
    return [view.instructionsSpeech].concat(view.questions.map((q) => q.speech)).filter(Boolean);
  };

  function audioStatus(test) {
    const v = voiceOf(test);
    if (!naturalVoice(test)) return { provider: v.provider, total: 0, ready: 0, missing: 0 };
    const texts = [...new Set(speechList(test))];
    const ready = texts.filter((t) => audioReady(clipId(v, test.language, t))).length;
    return { provider: v.provider, total: texts.length, ready, missing: texts.length - ready };
  }

  function makeClip(test, text) {
    const v = voiceOf(test);
    const id = clipId(v, test.language, text);
    const pieces = env.tts.synthesize({ provider: v.provider, voice: v.name, language: test.language, text });
    const parts = pieces.map((p, i) => ({ fileId: files.save(`read-aloud ${id} ${i + 1}.${p.mime.includes('wav') ? 'wav' : 'mp3'}`, p.mime, p.data, 'audio'), mime: p.mime }));
    db.insert('audio', { id, provider: v.provider, voice: v.name, chars: text.length, createdAt: now(), parts });
    audioIds && audioIds.add(id);
  }

  const canRecord = (user, test) => !!user.voiceAnswers || test.settings.recordingForAll;
  const sameClass = (test, className) => {
    const classes = test.classes.map((c) => c.toLowerCase());
    return classes.length === 0 || classes.includes(String(className || '').toLowerCase());
  };
  const testVisibleTo = (t, user) => t.status === 'open' && sameClass(t.data, user.className);

  function sanitizeAnswers(test, input) {
    const out = {};
    if (!input || typeof input !== 'object') return out;
    for (const q of test.questions) {
      if (q.type === 'section' || !(q.id in input)) continue;
      const v = input[q.id];
      const validOption = (x) => Number.isInteger(x) && x >= 0 && x < q.options.length;
      if (q.type === 'mc' && q.multiple) {
        const picks = Array.isArray(v) ? [...new Set(v.filter(validOption))] : [];
        if (picks.length && picks.length <= q.correct.length) out[q.id] = picks;
      } else if (q.type === 'mc') {
        if (validOption(v)) out[q.id] = v;
      } else if (q.type === 'blanks' || q.type === 'match') {
        // One string per blank / per item to match. Matching answers must be
        // one of the choices.
        const n = q.type === 'blanks' ? parseBlanks(q.prompt).length : q.pairs.length;
        const choices = q.type === 'match' ? new Set(matchChoices(q)) : null;
        const list = (Array.isArray(v) ? v : []).slice(0, n).map((x) => {
          const t = typeof x === 'string' ? x.slice(0, 500) : '';
          return choices && !choices.has(t) ? '' : t;
        });
        if (list.some((x) => x.trim())) out[q.id] = list;
      } else if (typeof v === 'string') {
        out[q.id] = v.slice(0, 20000);
      }
    }
    return out;
  }

  function studentAttemptPayload(a, user) {
    const test = a.snapshot;
    return {
      attempt: {
        id: a.id,
        status: a.status,
        startedAt: a.startedAt,
        deadlineAt: a.deadlineAt,
        serverNow: now(),
        answers: a.answers,
        violations: a.violations || 0,
      },
      test: viewOf(test),
      recordings: recordingsOf(a.id).map((r) => ({ id: r.id, questionId: r.questionId, duration: r.duration })),
      accommodations: {
        readAloud: !!user.readAloud || test.settings.readAloudForAll,
        voiceAnswers: canRecord(user, test),
      },
    };
  }

  // Guards every write a student makes during a test.
  function assertWritable(a, clientId) {
    if (a.status === 'locked') throw new HttpError(423, 'Your test is paused. Ask your teacher to unlock it.');
    if (a.status !== 'in_progress') throw new HttpError(409, 'This test has already been submitted.');
    if (a.clientId && clientId !== a.clientId)
      throw new HttpError(409, 'This test was opened in another window or device. Only the newest one can continue.');
    if (a.deadlineAt && now() > a.deadlineAt + DEADLINE_GRACE_MS) {
      submitAttempt(a, 'time');
      throw new HttpError(409, 'Time is up. Your test was submitted with your saved answers.');
    }
  }

  const cleanEmail = (s) => String(s || '').trim().toLowerCase();
  const isEmail = (s) => /^[^\s@,;]+@[^\s@,;]+\.[^\s@,;]+$/.test(s);

  function publicStudent(s) {
    return {
      id: s.id,
      email: s.id,
      name: s.name,
      className: s.className || '',
      readAloud: !!s.readAloud,
      voiceAnswers: !!s.voiceAnswers,
      extraTimePct: s.extraTimePct || 0,
    };
  }

  // ---------------------------------------------------------------- me

  route('GET', '/api/me', null, (ctx) => ({ user: ctx.user }));

  // ------------------------------------------------------ teacher: people

  route('GET', '/api/users', 'teacher', () => ({
    students: db
      .all('students')
      .map(publicStudent)
      .sort((a, b) => (a.className + a.name).localeCompare(b.className + b.name)),
    teachers: [{ id: ownerEmail(), email: ownerEmail(), owner: true }].concat(
      db.all('teachers').filter((t) => t.id !== ownerEmail()).map((t) => ({ id: t.id, email: t.id, owner: false })),
    ),
  }));

  route('POST', '/api/students/bulk', 'teacher', ({ body }) => {
    const people = Array.isArray(body.people) ? body.people.slice(0, 500) : [];
    const added = [];
    const skipped = [];
    for (const p of people) {
      const email = cleanEmail(p.email);
      if (!isEmail(email)) {
        skipped.push(`${p.email || '(empty)'}: not an email address`);
        continue;
      }
      const fields = {
        name: String(p.name || '').trim().slice(0, 100) || email.split('@')[0],
        className: String(p.className || '').trim().slice(0, 60),
      };
      if (db.get('students', email)) db.update('students', email, fields);
      else db.insert('students', { id: email, readAloud: false, voiceAnswers: false, extraTimePct: 0, ...fields });
      added.push(email);
    }
    return { added: added.length, skipped };
  });

  route('PUT', '/api/students/:id', 'teacher', ({ params, body }) => {
    const s = db.get('students', params.id);
    if (!s) throw new HttpError(404, 'Student not found.');
    const patch = {};
    if (body.name !== undefined) patch.name = String(body.name).trim().slice(0, 100) || s.name;
    if (body.className !== undefined) patch.className = String(body.className).trim().slice(0, 60);
    if (body.readAloud !== undefined) patch.readAloud = !!body.readAloud;
    if (body.voiceAnswers !== undefined) patch.voiceAnswers = !!body.voiceAnswers;
    if (body.extraTimePct !== undefined) patch.extraTimePct = Math.min(200, Math.max(0, parseInt(body.extraTimePct, 10) || 0));
    db.update('students', s.id, patch);
    return { student: publicStudent(db.get('students', s.id)) };
  });

  route('DELETE', '/api/students/:id', 'teacher', ({ params }) => {
    for (const a of db.all('attempts', true).filter((x) => x.studentId === params.id)) removeAttempt(a);
    db.remove('students', params.id);
    return { ok: true };
  });

  route('POST', '/api/teachers', 'teacher', ({ body }) => {
    const email = cleanEmail(body.email);
    if (!isEmail(email)) throw new HttpError(400, 'Enter an email address.');
    if (email !== ownerEmail() && !db.get('teachers', email)) db.insert('teachers', { id: email });
    return { ok: true };
  });

  route('DELETE', '/api/teachers/:id', 'teacher', ({ params }) => {
    if (params.id === ownerEmail()) throw new HttpError(400, 'The owner of the app is always a teacher.');
    db.remove('teachers', params.id);
    return { ok: true };
  });

  // ------------------------------------------------------- teacher: tests

  route('GET', '/api/tests', 'teacher', () => {
    sweepExpired(db.all('attempts', true));
    const fresh = db.all('attempts', true);
    return {
      tests: db
        .all('tests')
        .sort((a, b) => b.updatedAt - a.updatedAt)
        .map((t) => {
          const mine = fresh.filter((a) => a.testId === t.id);
          return {
            id: t.id,
            title: t.title,
            status: t.status,
            updatedAt: t.updatedAt,
            classes: t.data.classes,
            questionCount: t.data.questions.filter((q) => q.type !== 'section').length,
            active: mine.filter((a) => a.status === 'in_progress' || a.status === 'locked').length,
            toGrade: mine.filter((a) => a.status === 'submitted').length,
            returned: mine.filter((a) => a.status === 'returned').length,
          };
        }),
    };
  });

  route('POST', '/api/tests', 'teacher', ({ body, user }) => {
    const data = normalizeTest(body.data);
    const t = db.insert('tests', { ownerId: user.id, title: data.title, status: 'draft', data, updatedAt: now() });
    return { id: t.id };
  });

  route('GET', '/api/tests/:id', 'teacher', ({ params }) => {
    const t = getTest(params.id);
    return { id: t.id, status: t.status, data: t.data };
  });

  route('PUT', '/api/tests/:id', 'teacher', ({ params, body }) => {
    const t = getTest(params.id);
    const data = body.data !== undefined ? normalizeTest(body.data) : t.data;
    const status = ['draft', 'open', 'closed'].includes(body.status) ? body.status : t.status;
    db.update('tests', t.id, { title: data.title, status, data, updatedAt: now() });
    return { id: t.id, status, data };
  });

  route('POST', '/api/tests/:id/duplicate', 'teacher', ({ params, user }) => {
    const t = getTest(params.id);
    const data = Object.assign({}, t.data, { title: `${t.data.title} (copy)`.slice(0, 200) });
    const copy = db.insert('tests', { ownerId: user.id, title: data.title, status: 'draft', data, updatedAt: now() });
    return { id: copy.id };
  });

  route('DELETE', '/api/tests/:id', 'teacher', ({ params }) => {
    const t = getTest(params.id);
    for (const a of db.all('attempts', true).filter((x) => x.testId === t.id)) removeAttempt(a);
    db.remove('tests', t.id);
    return { ok: true };
  });

  route('GET', '/api/tests/:id/preview', 'teacher', ({ params }) => ({ test: viewOf(getTest(params.id).data) }));

  route('GET', '/api/tests/:id/audio', 'teacher', ({ params }) => audioStatus(getTest(params.id).data));

  // Makes missing natural-voice audio for a test, for up to ~40 seconds per
  // call; the page keeps calling until nothing is missing.
  route('POST', '/api/tests/:id/audio', 'teacher', ({ params }) => {
    const test = getTest(params.id).data;
    if (!naturalVoice(test)) throw new HttpError(400, 'This test uses the device voice, so there is no audio to prepare.');
    const v = voiceOf(test);
    const started = clock();
    let made = 0;
    for (const text of [...new Set(speechList(test))]) {
      if (audioReady(clipId(v, test.language, text))) continue;
      if (made > 0 && clock() - started > AUDIO_BUDGET_MS) break;
      makeClip(test, text);
      made++;
    }
    return Object.assign(audioStatus(test), { made });
  });

  // ▶ Try voice in the test editor: a short sample, not stored.
  route('POST', '/api/voices/try', 'teacher', ({ body }) => {
    if (!env.tts) throw new HttpError(400, 'Natural voices are not available here.');
    const provider = VOICE_PROVIDERS.includes(body.provider) && body.provider !== 'browser' ? body.provider : null;
    if (!provider) throw new HttpError(400, 'Choose Google or Chatterbox to try a natural voice.');
    const text = String(body.text || '').trim().slice(0, 300) || 'Hello! This is how I will read your test to your students.';
    const language = LANGUAGES.includes(body.language) ? body.language : 'en-US';
    const pieces = env.tts.synthesize({ provider, voice: String(body.name || '').slice(0, 100), language, text });
    return pieces[0];
  });

  route('GET', '/api/audio/:id/:n', 'any', ({ params }) => {
    const clip = db.get('audio', params.id);
    const part = clip && clip.parts && clip.parts[Number(params.n)];
    if (!part) throw new HttpError(404, 'Audio not found.');
    return { mime: part.mime, data: files.read(part.fileId), count: clip.parts.length };
  });

  function attemptRows(testId) {
    sweepExpired(db.all('attempts', true).filter((a) => a.testId === testId));
    const students = new Map(db.all('students').map((s) => [s.id, s]));
    const recs = db.all('recordings');
    return db
      .all('attempts')
      .filter((a) => a.testId === testId)
      .map((a) => {
        const s = students.get(a.studentId) || { name: a.studentId, className: '' };
        const answers = a.answers || {};
        const grading = a.grading || {};
        const recorded = new Set(recs.filter((r) => r.attemptId === a.id).map((r) => r.questionId));
        const auto = autoGrade(a.snapshot, answers, recorded);
        const toReview = Object.keys(auto).filter((qid) => auto[qid].review && !Number.isFinite(grading[qid] && grading[qid].points)).length;
        return {
          id: a.id,
          studentId: a.studentId,
          name: s.name,
          email: a.studentId,
          className: s.className || '',
          status: a.status,
          startedAt: a.startedAt,
          deadlineAt: a.deadlineAt,
          submittedAt: a.submittedAt,
          submitReason: a.submitReason,
          score: a.score,
          maxScore: a.maxScore != null ? a.maxScore : maxScore(a.snapshot),
          violations: a.violations || 0,
          toReview,
          answered: Object.keys(answers).length + [...recorded].filter((q) => !(q in answers)).length,
          questionCount: a.snapshot.questions.filter((q) => q.type !== 'section').length,
        };
      })
      .sort((x, y) => (x.className + x.name).localeCompare(y.className + y.name));
  }

  route('GET', '/api/tests/:id/attempts', 'teacher', ({ params }) => {
    const t = getTest(params.id);
    const attempts = attemptRows(t.id);
    const started = new Set(attempts.map((a) => a.studentId));
    const notStarted = db
      .all('students')
      .filter((s) => !started.has(s.id) && sameClass(t.data, s.className))
      .sort((a, b) => (a.className + a.name).localeCompare(b.className + b.name))
      .map((s) => ({ id: s.id, name: s.name, className: s.className }));
    return { test: { id: t.id, title: t.title, status: t.status, data: t.data }, attempts, notStarted };
  });

  route('POST', '/api/tests/:id/export', 'teacher', ({ params }) => {
    const t = getTest(params.id);
    const iso = (ms) => (ms ? (env.formatTime ? env.formatTime(ms) : new Date(ms).toISOString().replace('T', ' ').slice(0, 16)) : '');
    const rows = [['Name', 'Email', 'Class', 'Status', 'Score', 'Max', 'Started', 'Submitted', 'Times left the test']];
    for (const a of attemptRows(t.id))
      rows.push([a.name, a.email, a.className, a.status, a.score != null ? a.score : '', a.maxScore, iso(a.startedAt), iso(a.submittedAt), a.violations]);
    return { url: exportResults(t.title, rows) };
  });

  // ---------------------------------------------------- teacher: attempts

  route('GET', '/api/attempts/:id', 'teacher', ({ params }) => {
    const a = getAttempt(params.id);
    const s = db.get('students', a.studentId) || { id: a.studentId, name: a.studentId };
    return {
      attempt: {
        id: a.id,
        testId: a.testId,
        status: a.status,
        startedAt: a.startedAt,
        deadlineAt: a.deadlineAt,
        submittedAt: a.submittedAt,
        submitReason: a.submitReason,
        returnedAt: a.returnedAt,
        answers: a.answers,
        grading: a.grading,
        feedback: a.feedback || '',
        score: a.score,
        maxScore: maxScore(a.snapshot),
      },
      test: a.snapshot,
      auto: autoGrade(a.snapshot, a.answers, recordedIds(a.id)),
      student: publicStudent(s),
      events: db
        .all('events')
        .filter((e) => e.attemptId === a.id)
        .sort((x, y) => x.at - y.at)
        .map((e) => ({ at: e.at, type: e.type, detail: e.detail, counted: !!e.counted })),
      recordings: recordingsOf(a.id).map((r) => ({ id: r.id, questionId: r.questionId, duration: r.duration, createdAt: r.createdAt })),
    };
  });

  route('PUT', '/api/attempts/:id/grade', 'teacher', ({ params, body }) => {
    const a = getAttempt(params.id);
    if (a.status !== 'submitted' && a.status !== 'returned') throw new HttpError(409, 'The student has not submitted yet.');
    const grading = {};
    for (const q of a.snapshot.questions) {
      if (q.type === 'section') continue;
      const g = body.grading && body.grading[q.id];
      if (!g) continue;
      const pts = g.points === null || g.points === '' || g.points === undefined ? null : Number(g.points);
      grading[q.id] = {
        points: Number.isFinite(pts) ? Math.min(q.points, Math.max(0, pts)) : null,
        comment: String(g.comment || '').slice(0, 2000),
      };
    }
    const score = totalScore(a.snapshot, autoGrade(a.snapshot, a.answers, recordedIds(a.id)), grading);
    const ret = !!body.returnToStudent;
    db.update('attempts', a.id, {
      grading,
      feedback: String(body.feedback || '').slice(0, 5000),
      score,
      status: ret ? 'returned' : 'submitted',
      returnedAt: ret ? now() : null,
    });
    return { score, status: ret ? 'returned' : 'submitted' };
  });

  route('POST', '/api/attempts/:id/unlock', 'teacher', ({ params, body }) => {
    const a = getAttempt(params.id);
    if (a.status !== 'locked' && a.status !== 'in_progress') throw new HttpError(409, 'This test is already submitted.');
    const add = Math.min(240, Math.max(0, parseInt(body.addMinutes, 10) || 0));
    const deadline = a.deadlineAt ? Math.max(a.deadlineAt, now()) + add * 60e3 : null;
    db.update('attempts', a.id, { status: 'in_progress', deadlineAt: deadline });
    logEvent(a.id, 'unlocked', add ? `+${add} min` : '', false);
    return { ok: true };
  });

  route('POST', '/api/attempts/:id/force-submit', 'teacher', ({ params }) => {
    const a = getAttempt(params.id);
    if (a.status !== 'locked' && a.status !== 'in_progress') throw new HttpError(409, 'This test is already submitted.');
    submitAttempt(a, 'teacher');
    return { ok: true };
  });

  route('DELETE', '/api/attempts/:id', 'teacher', ({ params }) => {
    removeAttempt(getAttempt(params.id));
    return { ok: true };
  });

  // ------------------------------------------------------------ students

  // A student's home page: open tests for their class plus any they've started.
  function homeTests(user) {
    sweepExpired(db.all('attempts', true).filter((a) => a.studentId === user.id));
    const attempts = new Map(
      db
        .all('attempts', true)
        .filter((a) => a.studentId === user.id)
        .map((a) => [a.testId, getAttempt(a.id)]),
    );
    return {
      tests: db
        .all('tests')
        .filter((t) => t.status !== 'draft' && (attempts.has(t.id) || testVisibleTo(t, user)))
        .sort((a, b) => b.updatedAt - a.updatedAt)
        .map((t) => {
          const a = attempts.get(t.id);
          const snap = a ? a.snapshot : t.data;
          const show = a && a.status === 'returned' && snap.settings.showResults !== 'none';
          return {
            id: t.id,
            title: snap.title,
            timeLimitMin: snap.timeLimitMin,
            extraTimePct: user.extraTimePct || 0,
            questionCount: snap.questions.filter((q) => q.type !== 'section').length,
            testOpen: t.status === 'open',
            attempt: a
              ? {
                  id: a.id,
                  status: a.status,
                  submittedAt: a.submittedAt,
                  score: show ? a.score : null,
                  maxScore: show ? a.maxScore : null,
                  hasDetails: !!show && snap.settings.showResults === 'full',
                }
              : null,
          };
        }),
    };
  }

  route('GET', '/api/my/tests', 'student', ({ user }) => homeTests(user));

  // The teacher's 👁 view of one student's home page.
  route('GET', '/api/students/:id/home', 'teacher', ({ params }) => {
    const s = db.get('students', params.id);
    if (!s) throw new HttpError(404, 'Student not found.');
    return Object.assign({ student: publicStudent(s) }, homeTests({ id: s.id, className: s.className, extraTimePct: s.extraTimePct || 0 }));
  });

  // The rules shown before starting; does not start the clock.
  route('GET', '/api/my/tests/:id/rules', 'student', ({ params, user }) => {
    const t = getTest(params.id);
    const found = db.all('attempts', true).find((x) => x.testId === t.id && x.studentId === user.id);
    if (!found && !testVisibleTo(t, user)) throw new HttpError(403, 'This test is not open for you.');
    const data = found ? getAttempt(found.id).snapshot : t.data;
    return {
      test: { title: data.title, language: data.language, timeLimitMin: data.timeLimitMin, settings: data.settings },
      accommodations: { readAloud: !!user.readAloud || data.settings.readAloudForAll, voiceAnswers: canRecord(user, data) },
    };
  });

  route('POST', '/api/my/tests/:id/start', 'student', ({ params, body, user }) => {
    const clientId = String(body.clientId || '').slice(0, 64);
    if (!clientId) throw new HttpError(400, 'Missing client id.');
    const t = getTest(params.id);
    // Locked so a double click (or two tabs) can't create two attempts.
    return withLock(() => {
      const existing = db.all('attempts', true).find((x) => x.testId === t.id && x.studentId === user.id);
      if (existing) {
        const a = getAttempt(existing.id);
        sweepExpired([a]);
        if (a.status !== 'in_progress' && a.status !== 'locked') throw new HttpError(409, 'You have already submitted this test.');
        if (a.clientId && a.clientId !== clientId) logEvent(a.id, 'reopened', 'Test opened in a new window or device', false);
        db.update('attempts', a.id, { clientId });
        a.clientId = clientId;
        return studentAttemptPayload(a, user);
      }
      if (!testVisibleTo(t, user)) throw new HttpError(403, 'This test is not open for you.');
      const started = now();
      const limitMs = t.data.timeLimitMin * 60e3 * (1 + (user.extraTimePct || 0) / 100);
      const a = db.insert('attempts', {
        testId: t.id,
        studentId: user.id,
        status: 'in_progress',
        snapshot: t.data,
        startedAt: started,
        deadlineAt: limitMs ? Math.round(started + limitMs) : null,
        clientId,
        maxScore: maxScore(t.data),
        violations: 0,
        answers: {},
        grading: {},
        feedback: '',
      });
      logEvent(a.id, 'started', '', false);
      return studentAttemptPayload(getAttempt(a.id), user);
    });
  });

  route('PUT', '/api/my/attempts/:id/answers', 'student', ({ params, body, user }) => {
    const a = ownAttempt(params.id, user);
    assertWritable(a, body.clientId);
    db.update('attempts', a.id, { answers: sanitizeAnswers(a.snapshot, body.answers) });
    return { savedAt: now(), deadlineAt: a.deadlineAt, serverNow: now() };
  });

  route('POST', '/api/my/attempts/:id/events', 'student', ({ params, body, user }) => {
    const type = String(body.type || '');
    const counted = COUNTED_EVENTS.includes(type);
    if (!counted && !LOGGED_EVENTS.includes(type)) throw new HttpError(400, 'Unknown event.');
    const run = () => {
      const a = ownAttempt(params.id, user);
      if (a.status !== 'in_progress' || (a.clientId && body.clientId !== a.clientId)) {
        return { status: a.status, violations: a.violations || 0 };
      }
      const n = db.all('events').filter((e) => e.attemptId === a.id).length;
      if (n < MAX_EVENTS_PER_ATTEMPT) logEvent(a.id, type, body.detail, counted);
      if (!counted) return { status: a.status, violations: a.violations || 0 };
      const violations = (a.violations || 0) + 1;
      db.update('attempts', a.id, { violations });
      const settings = a.snapshot.settings;
      let status = a.status;
      if (settings.maxViolations > 0 && violations >= settings.maxViolations) {
        if (settings.onLimit === 'lock') {
          db.update('attempts', a.id, { status: 'locked' });
          logEvent(a.id, 'locked', `Reached ${settings.maxViolations} warnings`, false);
          status = 'locked';
        } else if (settings.onLimit === 'submit') {
          submitAttempt(a, 'violations');
          status = 'submitted';
        }
      }
      return { status, violations, maxViolations: settings.maxViolations };
    };
    // Counting is read-modify-write, so counted events take the lock.
    return counted ? withLock(run) : run();
  });

  route('GET', '/api/my/attempts/:id/status', 'student', ({ params, user }) => {
    const a = ownAttempt(params.id, user);
    sweepExpired([a]);
    return { status: a.status, deadlineAt: a.deadlineAt, serverNow: now(), violations: a.violations || 0 };
  });

  route('POST', '/api/my/attempts/:id/recordings', 'student', ({ params, body, user }) => {
    const a = ownAttempt(params.id, user);
    assertWritable(a, body.clientId);
    if (!canRecord(user, a.snapshot)) throw new HttpError(403, 'Voice answers are not turned on for you.');
    const q = a.snapshot.questions.find((x) => x.id === body.questionId && x.type !== 'section');
    if (!q) throw new HttpError(400, 'Unknown question.');
    const mime = String(body.mime || '').split(';')[0].trim().toLowerCase();
    if (!/^audio\/(webm|ogg|mp4|mpeg|wav|aac|x-m4a)$/.test(mime)) throw new HttpError(415, 'Unsupported audio format.');
    const data = String(body.data || '');
    if (data.length < 100) throw new HttpError(400, 'The recording is empty.');
    if (data.length > MAX_AUDIO_BASE64) throw new HttpError(413, 'That recording is too long.');
    removeRecordings(recordingsOf(a.id).filter((r) => r.questionId === q.id));
    const ext = mime.split('/')[1].replace('x-m4a', 'm4a');
    const s = db.get('students', user.id) || { name: user.id };
    const fileId = files.save(`${s.name} - ${a.snapshot.title} - ${q.id}.${ext}`, mime, data);
    const duration = Math.min(3600, Math.max(0, Number(body.duration) || 0));
    const r = db.insert('recordings', { attemptId: a.id, questionId: q.id, fileId, mime, size: data.length, duration, createdAt: now() });
    return { id: r.id, questionId: q.id, duration };
  });

  route('DELETE', '/api/my/attempts/:id/recordings/:rid', 'student', ({ params, body, user }) => {
    const a = ownAttempt(params.id, user);
    assertWritable(a, body.clientId);
    removeRecordings(recordingsOf(a.id).filter((r) => r.id === params.rid));
    return { ok: true };
  });

  route('POST', '/api/my/attempts/:id/submit', 'student', ({ params, body, user }) => {
    const a = ownAttempt(params.id, user);
    if (a.status === 'submitted' || a.status === 'returned') return { status: a.status };
    // Past the deadline assertWritable submits what was autosaved and throws.
    assertWritable(a, body.clientId);
    if (body.answers) {
      a.answers = sanitizeAnswers(a.snapshot, body.answers);
      db.update('attempts', a.id, { answers: a.answers });
    }
    submitAttempt(a, body.reason === 'time' ? 'time' : 'student');
    return { status: 'submitted' };
  });

  route('GET', '/api/my/attempts/:id/result', 'student', ({ params, user }) => {
    const a = ownAttempt(params.id, user);
    const mode = a.snapshot.settings.showResults;
    if (a.status !== 'returned' || mode === 'none') throw new HttpError(403, 'Your teacher has not shared results yet.');
    const out = { title: a.snapshot.title, score: a.score, maxScore: a.maxScore, feedback: a.feedback || '', mode };
    if (mode === 'full') {
      const auto = autoGrade(a.snapshot, a.answers, recordedIds(a.id));
      out.test = a.snapshot;
      out.answers = a.answers;
      out.marks = {};
      for (const qid of Object.keys(auto)) {
        const g = a.grading[qid] || {};
        out.marks[qid] = { points: Number.isFinite(g.points) ? g.points : auto[qid].auto, max: auto[qid].max, comment: g.comment || '' };
      }
      out.recordings = recordingsOf(a.id).map((r) => ({ id: r.id, questionId: r.questionId }));
    }
    return out;
  });

  // ---------------------------------------------------------- recordings

  route('GET', '/api/recordings/:id', 'any', ({ params, user }) => {
    const r = db.get('recordings', params.id);
    const a = r && db.get('attempts', r.attemptId);
    if (!r || !a || (user.role !== 'teacher' && a.studentId !== user.id)) throw new HttpError(404, 'Recording not found.');
    return { mime: r.mime, data: files.read(r.fileId) };
  });

  // ------------------------------------------------------------ settings

  route('GET', '/api/settings', 'teacher', () => env.settings.get());

  // Keys stay on the server: the page only learns whether one is saved.
  route('PUT', '/api/settings/voices', 'teacher', ({ body }) => {
    const url = body.chatterboxUrl === undefined ? undefined : String(body.chatterboxUrl || '').trim().replace(/\/+$/, '');
    if (url) {
      if (!/^https?:\/\/[^\s"'<>]+$/.test(url)) throw new HttpError(400, 'The Chatterbox address must start with https:// (or http://).');
      if (/^https?:\/\/(localhost|127\.|0\.0\.0\.0|10\.|192\.168\.|172\.(1[6-9]|2\d|3[01])\.)/i.test(url))
        throw new HttpError(400, 'That address only works on your own computer or network, and Google’s servers can’t reach it. Use a public address, for example from a Cloudflare tunnel (see the instructions).');
    }
    const clean = (v) => (v === undefined ? undefined : String(v || '').trim().slice(0, 500));
    env.settings.setVoices({ googleKey: clean(body.googleKey), chatterboxUrl: url, chatterboxKey: clean(body.chatterboxKey) });
    return env.settings.get();
  });

  route('PUT', '/api/settings', 'teacher', ({ body }) => {
    const url = String(body.recorderUrl || '').trim();
    if (url && !/^https:\/\/[^\s"'<>]+$/.test(url)) throw new HttpError(400, 'The recorder address must start with https://');
    env.settings.set({ recorderUrl: url });
    return env.settings.get();
  });

  // -------------------------------------------------------------- dispatch

  function handle(method, path, body, user) {
    for (const r of routes) {
      if (r.method !== method) continue;
      const m = r.re.exec(path);
      if (!m) continue;
      if (r.role) {
        if (!user || !user.role) throw new HttpError(403, 'You are not on the class list.');
        if (r.role !== 'any' && user.role !== r.role) throw new HttpError(403, 'Not allowed.');
      }
      const params = {};
      r.keys.forEach((k, i) => (params[k] = decodeURIComponent(m[i + 1])));
      return r.handler({ params, body: body || {}, user });
    }
    throw new HttpError(404, 'Not found.');
  }

  return { handle };
}

if (typeof module !== 'undefined') module.exports = { createApi, HttpError };

// ===== Store.js =====
// Tables kept as tabs of a Google Sheet. One row per record, one column per
// field. JSON fields come last and are split over several columns because a
// cell holds at most 50,000 characters.

const SCHEMAS = {
  students: ['id', 'name', 'className', 'readAloud:bool', 'voiceAnswers:bool', 'extraTimePct:num'],
  teachers: ['id'],
  tests: ['id', 'ownerId', 'title', 'status', 'updatedAt:num', 'data:json:8'],
  attempts: [
    'id', 'testId', 'studentId', 'status', 'startedAt:num', 'deadlineAt:num', 'submittedAt:num', 'submitReason',
    'score:num', 'maxScore:num', 'returnedAt:num', 'clientId', 'violations:num', 'feedback',
    'answers:json:4', 'grading:json:2', 'snapshot:json:8',
  ],
  events: ['id', 'attemptId', 'at:num', 'type', 'detail', 'counted:bool'],
  recordings: ['id', 'attemptId', 'questionId', 'fileId', 'mime', 'size:num', 'duration:num', 'createdAt:num'],
  // Natural-voice read-aloud audio: id = hash of voice + text; parts = [{ fileId, mime }].
  audio: ['id', 'provider', 'voice', 'chars:num', 'createdAt:num', 'parts:json:1'],
};
const JSON_CHUNK = 45000;

function parseSchema(spec) {
  const fields = [];
  let col = 1;
  for (const s of spec) {
    const [name, type = 'str', n] = s.split(':');
    const width = type === 'json' ? Number(n) : 1;
    fields.push({ name, type, col, width });
    col += width;
  }
  const light = fields.filter((f) => f.type !== 'json');
  return { fields, width: col - 1, lightWidth: light.length ? light[light.length - 1].col : 0 };
}

const PARSED = {};
for (const t of Object.keys(SCHEMAS)) PARSED[t] = parseSchema(SCHEMAS[t]);

function newId() {
  return Utilities.getUuid().replace(/-/g, '').slice(0, 12);
}

function encodeField(f, v) {
  if (f.type === 'json') {
    const s = v === undefined || v === null ? '' : JSON.stringify(v);
    if (s.length > JSON_CHUNK * f.width) throw new HttpError(413, `Too much data in ${f.name}. Make the test shorter or split it.`);
    const out = [];
    for (let i = 0; i < f.width; i++) out.push(s.slice(i * JSON_CHUNK, (i + 1) * JSON_CHUNK));
    return out;
  }
  if (v === undefined || v === null) return [''];
  if (f.type === 'bool') return [v ? true : false];
  if (f.type === 'num') return [Number(v)];
  return [String(v)];
}

function decodeField(f, cells) {
  if (f.type === 'json') {
    const s = cells.join('');
    if (!s) return null;
    try {
      return JSON.parse(s);
    } catch (e) {
      return null;
    }
  }
  const v = cells[0];
  if (f.type === 'bool') return v === true || v === 'TRUE' || v === 'true';
  if (f.type === 'num') return v === '' || v === null ? null : Number(v);
  return v === null || v === undefined ? '' : String(v);
}

class SheetStore {
  constructor(ss) {
    this.ss = ss;
    this.sheets = {};
    this.cache = {};
  }

  sheet(table) {
    if (this.sheets[table]) return this.sheets[table];
    const schema = PARSED[table];
    let sh = this.ss.getSheetByName(table);
    if (!sh) {
      sh = this.ss.insertSheet(table);
      const header = [];
      for (const f of schema.fields) for (let i = 0; i < f.width; i++) header.push(f.width > 1 ? `${f.name}#${i + 1}` : f.name);
      sh.getRange(1, 1, 1, header.length).setValues([header]).setFontWeight('bold');
      sh.setFrozenRows(1);
      // Plain text, so Sheets never turns a class like "10-3" into a date.
      for (const f of schema.fields)
        if (f.type === 'str' || f.type === 'json') sh.getRange(1, f.col, sh.getMaxRows(), f.width).setNumberFormat('@');
    }
    this.sheets[table] = sh;
    return sh;
  }

  rowToObject(table, row, light) {
    const obj = {};
    for (const f of PARSED[table].fields) {
      if (light && f.type === 'json') continue;
      obj[f.name] = decodeField(f, row.slice(f.col - 1, f.col - 1 + f.width));
    }
    return obj;
  }

  objectToRow(table, obj) {
    const row = [];
    for (const f of PARSED[table].fields) row.push.apply(row, encodeField(f, obj[f.name]));
    return row;
  }

  // light = skip the JSON columns (much faster for big tables).
  all(table, light) {
    const key = table + (light ? ':light' : '');
    if (this.cache[key]) return this.cache[key];
    const sh = this.sheet(table);
    const n = sh.getLastRow() - 1;
    const schema = PARSED[table];
    const width = light ? schema.lightWidth : schema.width;
    const rows = n > 0 ? sh.getRange(2, 1, n, width).getValues() : [];
    const out = rows.filter((r) => r[0] !== '').map((r) => this.rowToObject(table, r, light));
    this.cache[key] = out;
    return out;
  }

  rowIndex(table, id) {
    const sh = this.sheet(table);
    const n = sh.getLastRow() - 1;
    if (n <= 0) return -1;
    const ids = sh.getRange(2, 1, n, 1).getValues();
    for (let i = 0; i < ids.length; i++) if (String(ids[i][0]) === String(id)) return i + 2;
    return -1;
  }

  get(table, id) {
    const r = this.rowIndex(table, id);
    if (r < 0) return null;
    const row = this.sheet(table).getRange(r, 1, 1, PARSED[table].width).getValues()[0];
    return this.rowToObject(table, row, false);
  }

  insert(table, obj) {
    const rec = Object.assign({}, obj, { id: obj.id || newId() });
    this.sheet(table).appendRow(this.objectToRow(table, rec));
    this.cache = {};
    return rec;
  }

  // Writes only the given fields, so an autosave and a warning arriving at
  // the same moment never overwrite each other.
  update(table, id, fields) {
    const r = this.rowIndex(table, id);
    if (r < 0) throw new HttpError(404, 'Record not found.');
    const sh = this.sheet(table);
    for (const f of PARSED[table].fields) {
      if (!(f.name in fields) || f.name === 'id') continue;
      sh.getRange(r, f.col, 1, f.width).setValues([encodeField(f, fields[f.name])]);
    }
    this.cache = {};
  }

  remove(table, id) {
    const r = this.rowIndex(table, id);
    if (r > 0) this.sheet(table).deleteRow(r);
    this.cache = {};
  }

  removeWhere(table, pred) {
    const sh = this.sheet(table);
    const n = sh.getLastRow() - 1;
    if (n <= 0) return;
    const rows = sh.getRange(2, 1, n, PARSED[table].lightWidth || 1).getValues();
    for (let i = rows.length - 1; i >= 0; i--) if (pred(this.rowToObject(table, rows[i], true))) sh.deleteRow(i + 2);
    this.cache = {};
  }
}

if (typeof module !== 'undefined') module.exports = { SCHEMAS, PARSED, parseSchema };

// ===== Main.js =====
// Apps Script entry points: the web page (doGet) and the one function the
// page calls for everything else (rpc).

// The pop-up voice recorder. Apps Script pages may not use the microphone,
// so recording happens on this separate page (GitHub Pages) and the audio is
// sent back to the test. Teachers can change it on the Students page.
const DEFAULT_RECORDER_URL = 'https://avbitran.github.io/Lesson-Plans/apps-script/recorder.html';

function doGet() {
  // INDEX_HTML (the pages) is appended to Code.gs by build.js, so the whole
  // app is a single file to paste.
  const t = HtmlService.createTemplate(INDEX_HTML);
  // Escaped so a name like "</script>" can't break out of the page's script.
  t.boot = JSON.stringify(bootInfo()).replace(/</g, '\\u003c');
  return t
    .evaluate()
    .setTitle('Online Tests')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

function spreadsheet_() {
  const active = SpreadsheetApp.getActiveSpreadsheet();
  if (active) return active;
  const props = PropertiesService.getScriptProperties();
  const id = props.getProperty('SPREADSHEET_ID');
  if (id) return SpreadsheetApp.openById(id);
  const ss = SpreadsheetApp.create('Online Tests – data');
  props.setProperty('SPREADSHEET_ID', ss.getId());
  return ss;
}

function recordingsFolder_() {
  return folder_('RECORDINGS_FOLDER_ID', 'Online Tests – voice answers');
}

function audioFolder_() {
  return folder_('AUDIO_FOLDER_ID', 'Online Tests – read-aloud audio');
}

function folder_(prop, title) {
  const props = PropertiesService.getScriptProperties();
  const id = props.getProperty(prop);
  if (id) {
    try {
      return DriveApp.getFolderById(id);
    } catch (e) {
      // Folder was deleted; make a new one below.
    }
  }
  let folder;
  try {
    folder = DriveApp.createFolder(title);
  } catch (e) {
    if (/permission/i.test(String(e && e.message))) throw new HttpError(503, DRIVE_PERMISSION_HELP);
    throw e;
  }
  props.setProperty(prop, folder.getId());
  return folder;
}

// Google's consent screen lets people untick Drive; voice answers need it.
const DRIVE_PERMISSION_HELP =
  'Voice answers are not set up yet: the app needs permission to use Google Drive. ' +
  'Teacher: open the Apps Script editor, choose "authorize" in the function list at the top, click Run, ' +
  'and tick every box on the permission screen (including Google Drive).';

// Run this once from the Apps Script editor (choose "authorize", then Run)
// to grant every permission the app needs.
function authorize() {
  // With Google's per-permission consent, a permission that was unticked is
  // only offered again when the script asks for it explicitly.
  if (typeof ScriptApp.requireAllScopes === 'function') ScriptApp.requireAllScopes(ScriptApp.AuthMode.FULL);
  const ss = spreadsheet_();
  const folder = recordingsFolder_();
  audioFolder_();
  // Natural voices call Google's or Chatterbox's speech service from here.
  UrlFetchApp.getRequest('https://texttospeech.googleapis.com/');
  console.log('All set. Data: ' + ss.getUrl() + '  Voice answers: ' + folder.getUrl());
}

let lockHeld_ = false;
function withLock_(fn) {
  if (lockHeld_) return fn();
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(25000)) throw new HttpError(503, 'The system is busy. Try again in a moment.');
  lockHeld_ = true;
  try {
    return fn();
  } finally {
    lockHeld_ = false;
    lock.releaseLock();
  }
}

function env_(db) {
  return {
    db,
    ownerEmail: Session.getEffectiveUser().getEmail().toLowerCase(),
    withLock: withLock_,
    hash: (text) =>
      Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, text, Utilities.Charset.UTF_8)
        .map((b) => ((b + 256) % 256).toString(16).padStart(2, '0'))
        .join(''),
    tts: { synthesize: ttsSynthesize_ },
    files: {
      save(name, mime, base64, kind) {
        const blob = Utilities.newBlob(Utilities.base64Decode(base64), mime, name);
        return (kind === 'audio' ? audioFolder_() : recordingsFolder_()).createFile(blob).getId();
      },
      read(id) {
        return Utilities.base64Encode(DriveApp.getFileById(id).getBlob().getBytes());
      },
      remove(id) {
        try {
          DriveApp.getFileById(id).setTrashed(true);
        } catch (e) {
          // Already gone.
        }
      },
    },
    formatTime: (ms) => Utilities.formatDate(new Date(ms), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm'),
    exportResults(title, rows) {
      const ss = spreadsheet_();
      const name = ('Results: ' + title).replace(/[\[\]*?:\\/]/g, ' ').slice(0, 90);
      const sh = ss.getSheetByName(name) || ss.insertSheet(name);
      sh.clear();
      sh.getRange(1, 1, rows.length, rows[0].length).setValues(rows);
      sh.getRange(1, 1, 1, rows[0].length).setFontWeight('bold');
      sh.setFrozenRows(1);
      return ss.getUrl() + '#gid=' + sh.getSheetId();
    },
    settings: {
      get() {
        const p = PropertiesService.getScriptProperties();
        return {
          recorderUrl: p.getProperty('RECORDER_URL') || DEFAULT_RECORDER_URL,
          voices: {
            googleKeySet: !!p.getProperty('GOOGLE_TTS_KEY'),
            chatterboxUrl: p.getProperty('CHATTERBOX_URL') || '',
            chatterboxKeySet: !!p.getProperty('CHATTERBOX_KEY'),
          },
          spreadsheetUrl: spreadsheet_().getUrl(),
          recordingsUrl: (() => {
            try {
              return recordingsFolder_().getUrl();
            } catch (e) {
              return null; // shown on the Students page as "not set up"
            }
          })(),
        };
      },
      set(s) {
        const p = PropertiesService.getScriptProperties();
        if (s.recorderUrl) p.setProperty('RECORDER_URL', s.recorderUrl);
        else p.deleteProperty('RECORDER_URL');
      },
      // undefined = leave as it is, '' = remove.
      setVoices(v) {
        const p = PropertiesService.getScriptProperties();
        const put = (key, val) => {
          if (val === undefined) return;
          if (val) p.setProperty(key, val);
          else p.deleteProperty(key);
        };
        put('GOOGLE_TTS_KEY', v.googleKey);
        put('CHATTERBOX_URL', v.chatterboxUrl);
        put('CHATTERBOX_KEY', v.chatterboxKey);
      },
    },
  };
}

// ------------------------------------------------------- natural voices
// Each returns a list of { mime, data (base64) } pieces, played in order.

function ttsSynthesize_(o) {
  const p = PropertiesService.getScriptProperties();
  if (o.provider === 'google') return googleTts_(p.getProperty('GOOGLE_TTS_KEY'), o);
  if (o.provider === 'chatterbox') return chatterboxTts_(p.getProperty('CHATTERBOX_URL'), p.getProperty('CHATTERBOX_KEY'), o);
  throw new HttpError(400, 'Unknown voice.');
}

// Google Cloud Text-to-Speech. A voice name like "en-US-Neural2-F" also
// says its language; stretches in another language (Hebrew inside an English
// test) use Google's default voice for that language.
function googleTts_(key, o) {
  if (!key) throw new HttpError(400, 'Add your Google Cloud key first: Students → Settings → Read-aloud voices.');
  const nameLang = o.voice ? o.voice.split('-').slice(0, 2).join('-') : '';
  return ttsPieces(o.text, nameLang || o.language, 1500).map((piece) => {
    const own = o.voice && piece.lang.slice(0, 2) === nameLang.slice(0, 2);
    const body = {
      input: { text: piece.text },
      voice: own ? { languageCode: nameLang, name: o.voice } : { languageCode: piece.lang },
      audioConfig: { audioEncoding: 'MP3' },
    };
    const res = UrlFetchApp.fetch('https://texttospeech.googleapis.com/v1/text:synthesize?key=' + encodeURIComponent(key), {
      method: 'post',
      contentType: 'application/json',
      payload: JSON.stringify(body),
      muteHttpExceptions: true,
    });
    if (res.getResponseCode() !== 200) throw new HttpError(502, googleTtsError_(res));
    return { mime: 'audio/mpeg', data: JSON.parse(res.getContentText()).audioContent };
  });
}

function googleTtsError_(res) {
  let msg = '';
  try {
    msg = JSON.parse(res.getContentText()).error.message || '';
  } catch (e) {
    msg = res.getContentText().slice(0, 200);
  }
  if (/has not been used|is disabled|SERVICE_DISABLED/i.test(msg))
    return 'Google says the Text-to-Speech API is not turned on for your Cloud project. Turn it on (see the instructions) and try again in a few minutes.';
  if (/billing/i.test(msg)) return 'Google says your Cloud project needs a billing account before it can make voices.';
  if (/API key not valid|API_KEY_INVALID/i.test(msg)) return 'Google says the key is not valid. Copy it again from the Google Cloud console.';
  if (/voice/i.test(msg) && /not exist|invalid|unsupported/i.test(msg)) return 'Google does not have a voice with that name. Check the spelling, e.g. en-US-Neural2-F.';
  return 'Google could not make the audio: ' + msg;
}

// Chatterbox (or any server with the OpenAI-style /v1/audio/speech address).
// Sentences go in short pieces, which Chatterbox handles best.
function chatterboxTts_(url, key, o) {
  if (!url) throw new HttpError(400, 'Add your Chatterbox address first: Students → Settings → Read-aloud voices.');
  const endpoint = /\/v1\/audio\/speech$/.test(url) ? url : url.replace(/\/+$/, '') + '/v1/audio/speech';
  return ttsPieces(o.text, o.language, 300).map((piece) => {
    const body = { model: 'chatterbox', input: piece.text, response_format: 'mp3' };
    if (o.voice) body.voice = o.voice;
    if (piece.lang.slice(0, 2) !== 'en') body.language = piece.lang.slice(0, 2);
    let res;
    try {
      res = UrlFetchApp.fetch(endpoint, {
        method: 'post',
        contentType: 'application/json',
        payload: JSON.stringify(body),
        headers: key ? { Authorization: 'Bearer ' + key } : {},
        muteHttpExceptions: true,
      });
    } catch (e) {
      throw new HttpError(502, 'Could not reach your Chatterbox server at ' + url + '. Is the computer on and the tunnel running?');
    }
    const code = res.getResponseCode();
    const mime = String(res.getHeaders()['Content-Type'] || res.getHeaders()['content-type'] || '').split(';')[0].trim();
    if (code !== 200 || !/^audio\//.test(mime))
      throw new HttpError(502, 'Your Chatterbox server answered with an error (' + code + '): ' + res.getContentText().slice(0, 200));
    return { mime, data: Utilities.base64Encode(res.getContent()) };
  });
}

// Who is visiting. Works because the app runs as the teacher and is shared
// with "anyone in the school": Google then tells us the visitor's email.
function currentUser_(db, ownerEmail) {
  const email = String(Session.getActiveUser().getEmail() || '').toLowerCase();
  if (!email) return { role: null, email: '' };
  if (email === ownerEmail || db.get('teachers', email)) return { id: email, email, role: 'teacher', name: email.split('@')[0] };
  const s = db.get('students', email);
  if (!s) return { role: null, email };
  return {
    id: email,
    email,
    role: 'student',
    name: s.name,
    className: s.className,
    readAloud: !!s.readAloud,
    voiceAnswers: !!s.voiceAnswers,
    extraTimePct: s.extraTimePct || 0,
  };
}

function bootInfo() {
  const db = new SheetStore(spreadsheet_());
  const env = env_(db);
  const user = currentUser_(db, env.ownerEmail);
  return {
    user,
    recorderUrl: PropertiesService.getScriptProperties().getProperty('RECORDER_URL') || DEFAULT_RECORDER_URL,
  };
}

// Returns a JSON string: google.script.run mangles some values (undefined,
// nested nulls), and a string arrives exactly as sent.
function rpc(method, path, body) {
  try {
    const db = new SheetStore(spreadsheet_());
    const env = env_(db);
    const user = currentUser_(db, env.ownerEmail);
    const api = createApi(env);
    // Teacher edits are rare; serialising them avoids row shifts mid-write.
    // Making audio and trying voices take long and only add rows, so they
    // don't hold the lock (students starting a test need it).
    const run = () => api.handle(method, path, body, user);
    const slow = /\/audio$|^\/api\/voices\/try$/.test(path);
    const data = user.role === 'teacher' && method !== 'GET' && !slow ? withLock_(run) : run();
    return JSON.stringify({ ok: true, data: data === undefined ? null : data });
  } catch (e) {
    const status = e instanceof ValidationError ? 400 : e.status || 500;
    if (status === 500) console.error(e && e.stack ? e.stack : e);
    return JSON.stringify({ ok: false, status, error: status === 500 ? 'Something went wrong: ' + (e && e.message) : e.message });
  }
}

